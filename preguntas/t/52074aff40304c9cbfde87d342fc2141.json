    {
      "id": "en01-009",
      "dificultad": 15,
      "tipo": "elegir",
      "contexto": false,
      "es": {
        "pregunta": "¿Qué significa actually aquí?",
        "frase": "Actually, I'm from Lima.",
        "opciones": [
          {
            "texto": "En realidad",
            "correcta": true
          },
          {
            "texto": "Actualmente"
          },
          {
            "texto": "Exactamente"
          }
        ],
        "explica": "Es un falso amigo: actually significa «en realidad». Actualmente se dice currently o nowadays."
      },
      "en": {
        "pregunta": "What does actually mean here?",
        "frase": "Actually, I'm from Lima.",
        "opciones": [
          {
            "texto": "In fact",
            "correcta": true
          },
          {
            "texto": "Currently"
          },
          {
            "texto": "Exactly"
          }
        ],
        "explica": "Actually means \"in fact\". To say \"at the present time\", use currently or nowadays."
      },
      "zh-cn": {
        "pregunta": "这里的 actually 是什么意思？",
        "frase": "Actually, I'm from Lima.",
        "opciones": [
          {
            "texto": "其实",
            "correcta": true
          },
          {
            "texto": "目前"
          },
          {
            "texto": "确切地说"
          }
        ],
        "explica": "actually 的意思是“其实、实际上”，不是“目前”。“目前”要说 currently 或 nowadays。"
      }
    },
