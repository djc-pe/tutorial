    {
      "id": "en01-006",
      "dificultad": 12,
      "tipo": "elegir",
      "contexto": false,
      "opcionesEn": true,
      "es": {
        "pregunta": "¿Cómo se dice «Tengo 25 años»?",
        "opciones": [
          {
            "texto": "I'm 25.",
            "correcta": true
          },
          {
            "texto": "I have 25 years."
          },
          {
            "texto": "I am 25 year."
          }
        ],
        "explica": "En inglés la edad no se tiene, se es: I'm 25 o I'm 25 years old."
      },
      "en": {
        "pregunta": "How do you say that you are 25?",
        "opciones": [
          {
            "texto": "I'm 25.",
            "correcta": true
          },
          {
            "texto": "I have 25 years."
          },
          {
            "texto": "I am 25 year."
          }
        ],
        "explica": "In English you don't have an age, you are it: I'm 25 or I'm 25 years old."
      },
      "zh-cn": {
        "pregunta": "“我 25 岁”用英语怎么说？",
        "opciones": [
          {
            "texto": "I'm 25.",
            "correcta": true
          },
          {
            "texto": "I have 25 years."
          },
          {
            "texto": "I am 25 year."
          }
        ],
        "explica": "英语里说年龄要用 be 动词，不用 have：I'm 25 或 I'm 25 years old."
      }
    },
